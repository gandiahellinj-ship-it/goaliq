# Replit
.cache/
.local/

# Env files (local secrets, never commit). Patterns follow Vite convention:
# .env and .env.production-like files are intentionally NOT ignored so a
# committed example/scaffold can live there if desired in the future.
.env.local
.env.*.local

# api-server local secrets (Spoonacular key, PORT, etc.) — never commit.
artifacts/api-server/.env


# Fase 0 — salida de la vista previa de platos (local, no versionar)
artifacts/api-server/dish-preview-output/

# E2E (Playwright)
e2e/.env
e2e/test-results/
e2e/playwright-report/
e2e/.playwright/
