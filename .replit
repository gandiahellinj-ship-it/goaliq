modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
# ─────────────────────────────────────────────────────────────────────────
#  RAMA STAGING — las credenciales de Supabase NO van aquí a propósito.
#  El Repl de staging las toma de sus propios "Secrets", apuntando al Supabase
#  de STAGING (no a producción):
#    SUPABASE_URL, SUPABASE_ANON_KEY, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY,
#    SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL
#  Así el Repl de staging NO puede conectarse a la base de datos real por error.
#  ⚠️ NO fusionar este .replit a `main` sin revisar: en `main` (producción)
#     estas variables SÍ deben existir. Este bloque es específico de staging.
# ─────────────────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY = "pk_test_51TFPcuAC9aQrlGDt9STfcAx1doHw2jKkynhBMd711lvo6A2qz2Ii9M0W9gdDIksttdBCVQYB8i5i6n5fseAB9gmf00i2MlJTXF"

[nix]
channel = "stable-25_05"
