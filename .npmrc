auto-install-peers=false
strict-peer-dependencies=false

# Límites de concurrencia (22/07/2026): la máquina de build de Replit
# (Autoscale) se quedaba sin hilos ("pthread_create: Resource temporarily
# unavailable") con los valores por defecto de pnpm (16 descargas / 5
# procesos en paralelo). Valores conservadores: instalación algo más lenta
# pero estable en máquinas pequeñas. No afecta a la corrección del resultado.
network-concurrency=4
child-concurrency=2
fetch-retries=5

# (23/07/2026) La build de Replit moría en el paso de auto-instalación
# "pnpm add pnpm@10.33.2" (pthread_create sin recursos). Con esto, el pnpm
# que traiga la máquina instala directamente, sin sustituirse a sí mismo.
# La versión fijada sigue respetándose vía corepack en CI y en local, y el
# lockfile congelado garantiza el mismo resultado con pnpm 9/10.
manage-package-manager-versions=false
