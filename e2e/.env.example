# E2E de humo — copia este archivo a e2e/.env y rellena con datos de STAGING.
# ⚠️ REGLA (CLAUDE.md): NUNCA credenciales del Supabase de PRODUCCIÓN aquí.
#    Estos tests solo se ejecutan contra el entorno de STAGING.

# URL de la app desplegada en STAGING (no producción).
E2E_BASE_URL=https://TU-STAGING.replit.app

# Código de invitación beta válido en el Supabase de STAGING (para el test de registro).
E2E_BETA_CODE=STAGING-BETA-XXX

# (Opcional) Cuenta ya existente en STAGING para el test de login, si no quieres
# que dependa del test de registro.
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=
